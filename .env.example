# Copier en .env (jamais commité). Aucune valeur de secret dans git.
# La prod Cloud Run reçoit ses variables par Terraform, pas par ce fichier.

# Vertex AI (piste « nuage »). Sans projet, une réponse factice sert en dev.
GCLOUD_PROJECT=ghota-devine-prod
VERTEX_PROJECT_ID=ghota-devine-prod
VERTEX_LOCATION=global
# à figer après `gcloud ai models list` :
VERTEX_MODEL=gemini-flash-latest

# Contingent et anti-abus.
MAX_ROUNDS_PER_DAY=150
PER_IP_PER_WINDOW=5
WINDOW_MS=60000

# true en local : manches en mémoire ; la prod utilise Firestore via Terraform.
MEMORY_STORE=true

# oMLX (piste « Mac »). La clé vient de OMLX_API_KEY ou, à défaut,
# de ~/.omlx/settings.json.
LOCAL_MODEL=qwen38-flashnext-mtp
OMLX_URL=http://127.0.0.1:8000
